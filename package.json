{
  "name": "bustawin-vite",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "tsx ./server.ts",
    "dev-debug": "export DEBUG=vite:* && npm run dev",
    "dev-debug-open": "export DEBUG=vite:* && export HOST=0.0.0.0 && npm run dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint server.ts src.server ui tests *.config.ts eslint.config.js",
    "redeploy-docker": "docker-compose up --detach --build --no-deps bustawin",
    "redeploy-docker-full": "docker-compose down --remove-orphans -v && docker-compose build --pull && docker-compose up --detach",
    "start": "cross-env NODE_ENV=production tsx ./server.ts",
    "test": "vitest",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ci": "cross-env CI=1 playwright test",
    "test:run": "vitest run",
    "typecheck": "react-router typegen && tsc",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run test:e2e:ci"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.13",
    "@pintora/cli": "^0.8.1",
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "change-case": "^5.4.4",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.9",
    "estree-util-value-to-estree": "^3.5.0",
    "express": "^4.22.2",
    "feed": "^4.2.2",
    "gray-matter": "^4.0.3",
    "isbot": "^5.2.1",
    "iterated": "^0.2.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-to-string": "^4.0.0",
    "mdx-bundler": "^10.0.2",
    "morgan": "^1.11.0",
    "plotly.js-basic-dist": "^3.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-plotly.js": "^4.1.0",
    "react-router": "^8.3.0",
    "react-top-loading-bar": "^3.0.2",
    "rehype-highlight": "^7.0.0",
    "rehype-mdx-code-props": "^3.0.1",
    "remark-heading-id": "^1.0.1",
    "remix-utils": "^10.0.0",
    "tiny-invariant": "^1.3.3",
    "tsx": "^4.11.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/plotly.js": "^3.0.10",
    "@types/plotly.js-basic-dist": "^1.54.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-plotly.js": "^2.6.4",
    "@types/remark-heading-id": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.4.5",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "mdx-bundler": {
      "uuid": "^11.1.1"
    }
  }
}
