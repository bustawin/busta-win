{
  "include": [
    "env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "./react-router/types/**/*"
  ],
  "exclude": [
    "**/*.mdx",
    "build/**",
    "node_modules/**",
    "jutils/src/ui/components/form/**",
    "jutils/src/ui/components/icon/IconWithText.tsx",
    "jutils/src/ui/components/tooltip/**"
  ],
  "compilerOptions": {
    "types": ["@react-router/node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@src": [
        "./src.server"
      ],
      "@src/*": [
        "./src.server/*"
      ],
      "@ui": [
        "./ui"
      ],
      "@ui/*": [
        "./ui/*"
      ],
      "@jutils/*": [
        "./jutils/src/*"
      ],
      "@bootstrap/*": [
        "./node_modules/bootstrap/scss"
      ],
      "@highlight/*": [
        "./node_modules/highlight.js/scss"
      ],
      "@posts/*": [
        "./posts/*"
      ],
      "@style": [
        "./ui/styles/style.sass"
      ]
    },
    // Vite takes care of building everything, not tsc.
    "noEmit": true
  }
}
